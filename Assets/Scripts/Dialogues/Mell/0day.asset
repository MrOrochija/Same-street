  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Mell
    speakerSprite: {fileID: 3739253253603831928, guid: b52e9d55518539942a75329df892a1d1, type: 3}
    text: Do you have any plums?
    isNarrator: 0
  - speakerName: Mell
    speakerSprite: {fileID: 3739253253603831928, guid: b52e9d55518539942a75329df892a1d1, type: 3}
    text: Or a watermelon?
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Yeah...
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: We have all of this in our store.
    isNarrator: 0
  - speakerName: Mell
    speakerSprite: {fileID: 3739253253603831928, guid: b52e9d55518539942a75329df892a1d1, type: 3}
    text: "I'M ALREADY BLUSHING\u2014THIS ISN'T GOING TO BE CIVILIZED!"
    isNarrator: 0
