  lines:
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: HELLOOOO!
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: HI!
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: How are y...
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: ...
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: '!'
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: Has anyone dressed in black come by your place?
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: He's a little strange...
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: ...
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: No?
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: The last time I saw him was yesterday.
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: That's strange...
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: But okay.
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: BYEEE!!
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Good bye!
    isNarrator: 0
