  lines:
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: HI, MY LOVE!!!!
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: Oops..
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: I m-mean...
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: MY DEAR CASHIER!!!!!
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Hello?
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: HELLO, HOW ARE YOU???
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: I am fine and you?
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: '*WHAT*'
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: '*HE ASKED HOW I WAS DOING???????*'
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: I AM FINE TOO!
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: ALRIGHT, I HAVE TO GO!!!
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: BYE!!! HAVE A GOOD DAY!!!
    isNarrator: 0
