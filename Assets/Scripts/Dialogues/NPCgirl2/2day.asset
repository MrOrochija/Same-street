  lines:
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: HELLO!
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Hi!
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: I have a quick question for you...
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Yes?
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: Do you have a girlfriend?
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: ...
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: No?
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: Awesome!
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: THANK YOU!!!
    isNarrator: 0
  - speakerName: Yui
    speakerSprite: {fileID: -3938408722033731490, guid: dab06fa167d1fab4f8e520a8ad40774a, type: 3}
    text: BYEEEEE!
    isNarrator: 0
