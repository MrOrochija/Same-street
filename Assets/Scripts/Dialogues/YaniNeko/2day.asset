MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 48fdbf3537146a54d85e28845c879004, type: 3}
  m_Name: 2day
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: YaniNeko
    speakerSprite: {fileID: 632301620031758097, guid: 2c128a3ac8144904b9453a89a0202e8b, type: 3}
    text: You've come here again...
    isNarrator: 0
  - speakerName: YaniNeko
    speakerSprite: {fileID: 632301620031758097, guid: 2c128a3ac8144904b9453a89a0202e8b, type: 3}
    text: Do you want a smoke?
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: No, thanks, I don't smoke.
    isNarrator: 0
  - speakerName: YaniNeko
    speakerSprite: {fileID: 632301620031758097, guid: 2c128a3ac8144904b9453a89a0202e8b, type: 3}
    text: Don't you ever get tired of living a quiet life?
    isNarrator: 0
  - speakerName: YaniNeko
    speakerSprite: {fileID: 632301620031758097, guid: 2c128a3ac8144904b9453a89a0202e8b, type: 3}
    text: And you are...
    isNarrator: 0
  - speakerName: YaniNeko
    speakerSprite: {fileID: 632301620031758097, guid: 2c128a3ac8144904b9453a89a0202e8b, type: 3}
    text: who exactly?
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Oh, my name... I'm {Name}.
    isNarrator: 0
  - speakerName: YaniNeko
    speakerSprite: {fileID: 632301620031758097, guid: 2c128a3ac8144904b9453a89a0202e8b, type: 3}
    text: Nice to meet you, I'm YaniNeko.
    isNarrator: 0
  - speakerName: YaniNeko
    speakerSprite: {fileID: 632301620031758097, guid: 2c128a3ac8144904b9453a89a0202e8b, type: 3}
    text: Now, why don't you leave?
    isNarrator: 0
  - speakerName: YaniNeko
    speakerSprite: {fileID: 632301620031758097, guid: 2c128a3ac8144904b9453a89a0202e8b, type: 3}
    text: You're annoying me.
    isNarrator: 0
