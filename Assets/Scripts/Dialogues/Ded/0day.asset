  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: Oh, things used to be better back then.
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: Bread used to cost 2 kopecks.
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Grandpa, let's not talk about the past?
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: We're living in the future right now.
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: Oh, sorry, I just got a little carried away.
    isNarrator: 0
