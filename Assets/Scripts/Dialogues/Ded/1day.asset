  m_Script: {fileID: 11500000, guid: 48fdbf3537146a54d85e28845c879004, type: 3}
  m_Name: 1day
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: How's your health?
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: I'm fine.
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: I'll give you a piece of advice.
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: Cherish the time you have right now.
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: Since time cannot be turned back.
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Thanks for the advice!
    isNarrator: 0
