  m_Script: {fileID: 11500000, guid: 48fdbf3537146a54d85e28845c879004, type: 3}
  m_Name: 2day
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: I remember my youth...
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: It was such a wonderful time.
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: It's a shame we can't go back to that wonderful time.
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Just accept it.
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Time Can't Be Turned Back.
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: You're right...
    isNarrator: 0
