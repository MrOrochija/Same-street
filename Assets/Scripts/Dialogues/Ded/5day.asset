  lines:
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: And what about you?
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: How's your health?
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Everything's great with me.
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: How about you?
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: Everything's fine with me, too.
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: Bye.
    isNarrator: 0
  - speakerName: Anton
    speakerSprite: {fileID: 5334759464859404885, guid: 5f3615ec09ce3cc4394a17803e5c15fd, type: 3}
    text: Good luck.
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Bye!
    isNarrator: 0
