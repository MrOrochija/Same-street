  m_Script: {fileID: 11500000, guid: 48fdbf3537146a54d85e28845c879004, type: 3}
  m_Name: 5day
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Hello!
    isNarrator: 0
  - speakerName: Artur
    speakerSprite: {fileID: 3211710811241180148, guid: 8ae687a695ac78a468c115a4141714f7, type: 3}
    text: Hello.
    isNarrator: 0
  - speakerName: Artur
    speakerSprite: {fileID: 3211710811241180148, guid: 8ae687a695ac78a468c115a4141714f7, type: 3}
    text: Don't you get bored doing the same thing every day?
    isNarrator: 0
  - speakerName: Artur
    speakerSprite: {fileID: 3211710811241180148, guid: 8ae687a695ac78a468c115a4141714f7, type: 3}
    text: I see you're here every day, standing until late at night.
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: No, everything's fine. It's not hard for me.
    isNarrator: 0
  - speakerName: Artur
    speakerSprite: {fileID: 3211710811241180148, guid: 8ae687a695ac78a468c115a4141714f7, type: 3}
    text: Then okay.
    isNarrator: 0
  - speakerName: Artur
    speakerSprite: {fileID: 3211710811241180148, guid: 8ae687a695ac78a468c115a4141714f7, type: 3}
    text: Bye.
    isNarrator: 0
  - speakerName: Player
    speakerSprite: {fileID: -6535718206531406139, guid: 06fdfd053eca4b54db118ee618099550, type: 3}
    text: Bye!
    isNarrator: 0
